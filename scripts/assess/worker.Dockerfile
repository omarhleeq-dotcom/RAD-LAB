# Build context is generated by build-worker.mjs after npm ci. No checkout/secret COPY.
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df
WORKDIR /app
COPY --chown=root:root --chmod=0444 worker.cjs worker-main.mjs manifest.json ./
ENV NODE_ENV=production
USER node
ENTRYPOINT ["node", "/app/worker-main.mjs"]
