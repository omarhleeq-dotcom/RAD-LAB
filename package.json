{
  "name": "rad-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual (Arabic/English) educational radiography simulation platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "RADLAB_STATIC_EXPORT=1 next build && node scripts/pages/finalize-headers.mjs",
    "preview:smoke": "node scripts/preview/smoke.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "qa:golden": "UPDATE_GOLDEN=1 vitest run src/features/qa",
    "qa:characterise": "UPDATE_CHARACTERISATION=1 vitest run src/features/qa/characterisation.test.ts",
    "status:check": "node scripts/status/check-status.mjs",
    "qa:visual": "node scripts/qa/run-matrix.mjs",
    "qa:a11y": "node scripts/qa/a11y-audit.mjs",
    "docs:check": "node scripts/docs/check-docs.mjs",
    "docs:test": "node --test scripts/docs/*.test.mjs scripts/status/*.test.mjs",
    "status:summary": "node scripts/status/summary.mjs",
    "docs:context": "node scripts/docs/context.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
